# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated browser origins allowed to call the API (dev: the Vite server)
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/vareon_corner

# ---- Auth (REQUIRED in production, min 32 chars each, must differ) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Only if the API and site share a parent domain on different subdomains
# COOKIE_DOMAIN=.example.com
# Number of reverse proxies in front of the app (nginx / Render / Railway = 1)
# TRUST_PROXY=1

# ---- First admin (used by `npm run seed`) ----
ADMIN_NAME=
ADMIN_EMAIL=
# min 10 chars with upper, lower and a number
ADMIN_PASSWORD=

# ---- Optional social / contact defaults (editable later in the admin dashboard) ----
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
SOCIAL_X=
SOCIAL_LINKEDIN=
# International format, e.g. +971500000000
WHATSAPP_NUMBER=

# ---- E-mail (SMTP): sign-up codes, password reset codes and alert e-mails ----
# Leave these empty while developing: every e-mail is then printed in the server terminal (copy the 6-digit code from there).
# In production they are REQUIRED, otherwise nobody can register or reset a password.
#
# Gmail: turn on 2-Step Verification, then create an "App password" at https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_SECURE=false   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>
# Brevo / SendGrid / Mailgun / your host's SMTP work the same way (port 465 -> SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vareon Motors <youur@gmail.com>"
# Public address of the site (used for links inside e-mails)
APP_URL=http://localhost:5173
# Seconds a visitor must wait before asking for another code
OTP_RESEND_SECONDS=60

# ---- Continue with Google (optional) ----
# console.cloud.google.com > APIs & Services > Credentials > Create credentials > OAuth client ID > "Web application"
# Authorised JavaScript origins: http://localhost:5173 (dev) and your real https domain. No redirect URI is needed.
GOOGLE_CLIENT_ID=

